{
  "name": "mochart-monorepo",
  "version": "1.0.0",
  "description": "Monorepo for the mochart charting library, the valide validation library, and the mochart demo app",
  "private": true,
  "license": "BSD-3-Clause",
  "author": {
    "name": "Jon Harris",
    "url": "https://github.com/jharris4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jharris4/mochart.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "scripts": {
    "dev": "npm run dev -w mochart-demo",
    "build": "npm run build -w mochart-demo",
    "build:libs": "npm run build -w valide && npm run build -w mochart && npm run build -w mochart-svelte",
    "prepare": "npm run build:libs",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "playwright-core": "^1.61.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
