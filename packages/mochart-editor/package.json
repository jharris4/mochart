{
  "name": "@mochart/editor",
  "version": "1.0.0",
  "description": "Framework-neutral JSON editor with Mochart config intelligence",
  "keywords": [
    "json",
    "editor",
    "codemirror",
    "completions",
    "validation",
    "mochart"
  ],
  "license": "MIT",
  "author": {
    "name": "Jon Harris",
    "url": "https://github.com/jharris4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jharris4/mochart.git"
  },
  "homepage": "https://mochart.org",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./editor.css": "./css/editor.css"
  },
  "files": [
    "src",
    "dist",
    "css"
  ],
  "dependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/lint": "^6.0.0",
    "@codemirror/search": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lezer/common": "^1.0.0",
    "@lezer/highlight": "^1.0.0",
    "codemirror": "^6.0.0"
  },
  "peerDependencies": {
    "@mochart/core": "^1.0.0"
  },
  "scripts": {
    "generate": "node --import tsx ../mochart/scripts/generateEditorModel.ts",
    "prebuild": "npm run generate",
    "build": "tsc -p tsconfig.build.json",
    "predev": "npm run generate",
    "dev": "vite --config playground/vite.config.ts",
    "build:playground": "npm run generate && vite build --config playground/vite.config.ts",
    "test": "npm run generate && vitest run",
    "typecheck": "npm run generate && tsc --noEmit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@mochart/core": "^1.0.0",
    "tsx": "^4.20.6"
  }
}
