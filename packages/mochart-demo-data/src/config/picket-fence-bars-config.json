{
  "version": "1.0.0",
  "title": {
    "text": "Picket Fence Bars"
  },
  "animation": {
    "animate": true,
    "expansionDuration": 1500,
    "initialDuration": 3000,
    "valueChangeDuration": 3000,
    "collapseDuration": 1500,
    "focusDuration": 800
  },
  "categoryAxis": {
    "title": "Month",
    "axisLine": true,
    "axisLineMargin": 0,
    "gridLines": true,
    "tickLabelFormat": "%b",
    "tickLabelRotation": 45,
    "tickCount": 12,
    "type": "date",
    "scale": "ordinal",
    "dateUTC": true,
    "valueLabel": "Category",
    "valueFormat": "%B",
    "property": "date",
    "side": "end"
  },
  "valueAxes": {
    "visible": true,
    "axisLineMargin": 0,
    "gridLines": true,
    "tickLabelFormat": "$s",
    "title": "Monthly Amount",
    "min": 0,
    "side": "start"
  },
  "seriesStacks": {},
  "seriesDefaults": {
    "renderer": "bar",
    "markerShape": null
  },
  "series": [
    {
      "title": "Round",
      "property": "value1",
      "capSize": 15,
      "capType": "round"
    },
    {
      "title": "Curve",
      "property": "value2",
      "capSize": 15,
      "capType": "curve"
    },
    {
      "title": "Point",
      "property": "value3",
      "capSize": 15,
      "capType": "point"
    }
  ]
}
