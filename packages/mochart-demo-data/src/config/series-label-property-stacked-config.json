    "renderer": "area"
  },
  "series": [
    {
      "property": "value1",
      "labelProperty": "value1",
      "title": "Stacked Area 1"
    },
    {
      "property": "value2",
      "labelProperty": "value2",
      "title": "Stacked Area 2"
    },
    {
      "property": "value3",
      "labelProperty": "value3",
      "title": "Stacked Area 3"
    }
  ]
}
