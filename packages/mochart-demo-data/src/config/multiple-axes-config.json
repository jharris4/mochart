{
  "version": "1.0.0",
  "title": {
    "text": "Multiple Axes"
  },
  "animation": {
    "animate": true,
    "expansionDuration": 500,
    "initialDuration": 500,
    "valueChangeDuration": 500,
    "collapseDuration": 500,
    "focusDuration": 700
  },
  "categoryAxis": {
    "before": false,
    "title": "Time (in Minutes)",
    "axisLine": true,
    "axisLineMargin": 0,
    "tickLabelFormat": "%_H:%M",
    "type": "date",
    "scale": "linear",
    "dateUTC": true,
    "valueLabel": "Time",
    "property": "time"
  },
  "valueAxisDefaults": {
    "axisLineMargin": 0,
    "gridLines": false,
    "min": 0
  },
  "valueAxes": [
    {
      "before": true,
      "tickLabelFormat": "$s",
      "title": "Sales Value",
      "id": "VA1"
    },
    {
      "before": true,
      "tickLabelFormat": "$s",
      "id": "VA0"
    },
    {
      "before": false,
      "gridLines": true,
      "id": "VA2"
    },
    {
      "before": false,
      "title": "Sold Count",
      "id": "VA3"
    }
  ],
  "seriesDefaults": {
    "renderer": "line",
    "markerShape": null
  },
  "series": [
    {
      "title": "Sales A",
      "axis": "VA0",
      "property": "sales_a"
    },
    {
      "title": "Running Sales A",
      "axis": "VA1",
      "property": "running_sales_a"
    },
    {
      "title": "Sales B",
      "axis": "VA0",
      "property": "sales_b"
    },
    {
      "title": "Running Sales B",
      "axis": "VA1",
      "property": "running_sales_b"
    },
    {
      "title": "Count A",
      "axis": "VA2",
      "property": "count_a"
    },
    {
      "title": "Running Count A",
      "axis": "VA3",
      "property": "running_count_a"
    },
    {
      "title": "Count B",
      "axis": "VA2",
      "property": "count_b"
    },
    {
      "title": "Running Count B",
      "axis": "VA3",
      "property": "running_count_b"
    }
  ]
}
