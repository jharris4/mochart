{
  "version": "1.0.0",
  "title": {
    "text": "Pos/Neg Picket Fence Bars"
  },
  "plot": {
    "inverted": false
  },
  "animation": {
    "animate": true,
    "expansionDuration": 300,
    "initialDuration": 3000,
    "valueChangeDuration": 3000,
    "collapseDuration": 300,
    "focusDuration": 500
  },
  "categoryAxis": {
    "valueLabel": "Category",
    "property": "categoryDO",
    "type": "date",
    "scale": "ordinal"
  },
  "valueAxisDefaults": {
    "base": 0,
    "softMin": 0,
    "softMax": 0,
    "tickLabelFormat": "$.2f"
  },
  "valueAxes": [
    {
      "id": "VA0",
      "before": true
    },
    {
      "id": "VA1",
      "before": false
    }
  ],
  "seriesDefaults": {
    "renderer": "bar",
    "markerShape": null
  },
  "series": [
    {
      "title": "Small Pos/Neg Dollars",
      "axis": "VA0",
      "property": "value7",
      "capSize": 15,
      "capType": "point"
    },
    {
      "title": "Large Pos/Neg Dollars",
      "axis": "VA1",
      "property": "value9",
      "capSize": 15,
      "capType": "curve"
    }
  ]
}
