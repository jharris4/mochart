{
  "version": "1.0.0",
  "title": {
    "text": "Capped Inverted Bars"
  },
  "plot": {
    "inverted": true
  },
  "animation": {
    "animate": true,
    "expansionDuration": 1500,
    "initialDuration": 8000,
    "valueChangeDuration": 8000,
    "collapseDuration": 1500,
    "focusDuration": 800
  },
  "categoryAxis": {
    "title": "Month",
    "axisLine": true,
    "axisLineMargin": 0,
    "gridLines": true,
    "tickLabelFormat": "%b",
    "tickLabelRotation": 45,
    "tickCount": 12,
    "type": "date",
    "scale": "ordinal",
    "dateUTC": true,
    "valueLabel": "Category",
    "valueFormat": "%B",
    "property": "date",
    "side": "end"
  },
  "valueAxes": {
    "visible": true,
    "axisLineMargin": 0,
    "gridLines": true,
    "tickLabelFormat": "$s",
    "title": "Monthly Amount",
    "min": -5000,
    "max": 5000,
    "side": "start"
  },
  "seriesStacks": {},
  "seriesDefaults": {
    "renderer": "bar",
    "markerShape": null
  },
  "series": [
    {
      "title": "Round",
      "property": "value1",
      "capSize": 15,
      "capType": "round",
      "capExpand": false,
      "shapeStyle": {
        "normal": {
          "strokeColor": "#1f77b4",
          "fillColor": "#1f77b4"
        }
      }
    },
    {
      "title": "Curve",
      "property": "value2",
      "capSize": 15,
      "capType": "curve",
      "capExpand": false,
      "shapeStyle": {
        "normal": {
          "strokeColor": "#ff7f0e",
          "fillColor": "#ff7f0e"
        }
      }
    },
    {
      "title": "Point",
      "property": "value3",
      "capSize": 15,
      "capType": "point",
      "capExpand": false,
      "shapeStyle": {
        "normal": {
          "strokeColor": "#2ca02c",
          "fillColor": "#2ca02c"
        }
      }
    },
    {
      "title": "Round Expand",
      "property": "value1",
      "capSize": 15,
      "capType": "round",
      "capExpand": true,
      "shapeStyle": {
        "normal": {
          "strokeColor": "#aec7e8",
          "fillColor": "#aec7e8"
        }
      }
    },
    {
      "title": "Curve Expand",
      "property": "value2",
      "capSize": 15,
      "capType": "curve",
      "capExpand": true,
      "shapeStyle": {
        "normal": {
          "strokeColor": "#ffbb78",
          "fillColor": "#ffbb78"
        }
      }
    },
    {
      "title": "Point Expand",
      "property": "value3",
      "capSize": 15,
      "capType": "point",
      "capExpand": true,
      "shapeStyle": {
        "normal": {
          "strokeColor": "#98df8a",
          "fillColor": "#98df8a"
        }
      }
    },
    {
      "title": "None",
      "property": "value4",
      "capSize": 15,
      "capType": null,
      "shapeStyle": {
        "normal": {
          "strokeColor": "#d62728",
          "fillColor": "#d62728"
        }
      }
    }
  ]
}
