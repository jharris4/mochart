{
  "version": "1.0.0",
  "title": {
    "text": "Ordinal Dates"
  },
  "animation": {
    "animate": true,
    "expansionDuration": 300,
    "initialDuration": 300,
    "valueChangeDuration": 300,
    "collapseDuration": 300,
    "focusDuration": 500
  },
  "categoryAxis": {
    "property": "month_bought",
    "type": "date",
    "axisLine": true,
    "axisLineMargin": 0,
    "gridLines": true,
    "scale": "ordinal",
    "tickLabelFormat": "%B %Y",
    "tickLabelTruncationEnabled": false,
    "valueFormat": "%B %Y",
    "valueLabel": "Category",
    "side": "end"
  },
  "valueAxes": [
    {
      "id": "VA0",
      "visible": true,
      "axisLineMargin": 0,
      "gridLines": true,
      "tickLabelFormat": "$.0f",
      "min": 0,
      "side": "start"
    }
  ],
  "seriesStacks": [
    {
      "axis": "VA0",
      "id": "SS0"
    }
  ],
  "series": [
    {
      "axis": "VA0",
      "stack": "SS0",
      "property": "total",
      "renderer": "bar",
      "title": "Total"
    }
  ]
}
