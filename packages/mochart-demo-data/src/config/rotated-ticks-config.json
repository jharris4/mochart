{
  "version": "1.0.0",
  "title": {
    "text": "Rotated Ticks Example"
  },
  "legend": {
    "visible": true
  },
  "categoryAxis": {
    "valueLabel": "Category",
    "property": "categoryDO",
    "type": "date",
    "scale": "ordinal",
