    "tickLabelRotation": 90,
    "title": "Date Ticks Rotated 90 Degrees"
  },
  "valueAxes": {
    "tickLabelRotation": 45,
    "title": "Ticks Rotated 45 Degrees"
  },
  "series": {
    "property": "value9",
    "title": "Large Number",
    "renderer": "line"
  }
}
