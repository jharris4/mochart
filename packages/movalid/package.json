{
  "name": "movalid",
  "version": "1.0.0",
  "description": "Simple yet powerful TypeScript validators",
  "keywords": [
    "validation",
    "chainable",
    "type checking"
  ],
  "license": "BSD-3-Clause",
  "author": {
    "name": "Jon Harris",
    "url": "https://github.com/jharris4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jharris4/mochart.git"
  },
  "type": "module",
  "main": "./dist/validators.js",
  "module": "./dist/validators.js",
  "types": "./dist/validators.d.ts",
  "exports": {
    ".": {
      "types": "./dist/validators.d.ts",
      "development": "./src/validators.ts",
      "default": "./dist/validators.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
