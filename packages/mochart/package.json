{
  "name": "@mochart/core",
  "version": "1.0.0",
  "description": "Animated interactive SVG charting library with zero framework dependencies",
  "keywords": [
    "chart",
    "animation",
    "responsive",
    "dynamic",
    "svg"
  ],
  "license": "MIT",
  "author": {
    "name": "Jon Harris",
    "url": "https://github.com/jharris4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jharris4/mochart.git"
  },
  "homepage": "https://mochart.org",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/mochart.js",
  "module": "./dist/mochart.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "default": "./dist/mochart.js"
    },
    "./mochart.css": "./css/mochart.css"
  },
  "files": [
    "src",
    "dist",
    "css"
  ],
  "dependencies": {
    "d3-color": "^3.1.0",
    "d3-format": "^3.1.2",
    "d3-interpolate": "^3.0.1",
    "d3-path": "^3.1.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "d3-time-format": "^4.1.0",
    "@mochart/movalid": "^1.0.0"
  },
  "scripts": {
    "prebuild": "tsx scripts/stampVersion.ts",
    "build": "vite build && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "eslint .",
    "generate-docs": "tsx scripts/generator.ts",
    "generate-jsdoc": "tsx scripts/generateJsdoc.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.20.6"
  }
}
