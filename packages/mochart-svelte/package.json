{
  "name": "mochart-svelte",
  "version": "1.0.0",
  "description": "Svelte 5 components for the mochart charting library",
  "keywords": [
    "chart",
    "svelte",
    "animation",
    "responsive",
    "svg",
    "mochart"
  ],
  "license": "BSD-3-Clause",
  "author": {
    "name": "Jon Harris",
    "url": "https://github.com/jharris4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jharris4/mochart.git"
  },
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "dependencies": {
    "mochart": "^1.0.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "svelte": "^5.56.5",
    "svelte-check": "^4.1.4",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  }
}
